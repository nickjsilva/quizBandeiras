<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#000000"
    tools:context=".Bandeira1">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:background="#000000"
        android:backgroundTint="@android:color/system_accent2_200"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnResponder"
            android:layout_width="386dp"
            android:layout_height="59dp"
            android:backgroundTint="@color/black"
            android:fontFamily="@font/press_start_2p"
            android:onClick="calcular"
            android:shadowColor="@color/black"
            android:text="Responder"
            android:textColor="@color/white"
            android:textColorHighlight="@color/design_default_color_error"
            android:textColorHint="@color/black"
            android:textColorLink="@color/design_default_color_error"
            android:textSize="30sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.64"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.919"
            app:rippleColor="#3F51B5" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="382dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/press_start_2p"
            android:text="Que País é este?"
            android:textAlignment="center"
            android:textColor="@android:color/system_accent1_1000"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.022" />

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="387dp"
            android:layout_height="294dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.775">

            <RadioButton
                android:id="@+id/alternativa1"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:fontFamily="@font/press_start_2p"
                android:text="Maior Time do Brasil"
                android:textColor="@color/black" />

            <RadioButton
                android:id="@+id/alternativa2"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:fontFamily="@font/press_start_2p"
                android:text="Egito"
                android:textColor="@color/black" />

            <RadioButton
                android:id="@+id/alternativa3"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/press_start_2p"
                android:text="Somália"
                android:textColor="@color/black" />

            <RadioButton
                android:id="@+id/alternativa4"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/press_start_2p"
                android:text="Iêmen"
                android:textColor="@color/black" />

        </RadioGroup>

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.493"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.186"
            app:srcCompat="@drawable/bandeira_iemen" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>